---
interface Props {
  /** The shell command shown above the title, e.g. `cd /music`. */
  command: string;
  title: string;
  description?: string | undefined;
}

const { command, title, description } = Astro.props;
---

<header class="listing-head">
  <p class="prompt">
    <span class="ps1">$</span> {command}
  </p>
  <h1 class="page-title">{title}</h1>
  {description && <p class="description">{description}</p>}
</header>

<style>
  .listing-head {
    display: grid;
    gap: 0.6rem;
  }

  .prompt {
    margin: 0;
  }

  .description {
    margin: 0;
    color: var(--muted);
    max-width: 38rem;
  }
</style>
