---
import { companionRepo } from '../lib/model';

interface Props {
  repo: string;
  snapshot?: string | undefined;
}

const { repo, snapshot } = Astro.props;
const companion = companionRepo(repo, snapshot);
const target = companion.snapshot ?? companion;
---

<p class="companion">
  <span class="label">companion repo:</span>
  <a href={target.url} rel="noopener">
    {companion.name}
    {companion.snapshot && <> @ {companion.snapshot.name}</>}
    <span aria-hidden="true">↗</span>
  </a>
</p>

<style>
  .companion {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .label {
    color: var(--muted);
  }

  a {
    color: var(--accent-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }
</style>
