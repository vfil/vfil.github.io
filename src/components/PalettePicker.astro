---
/**
 * The reader's Palette picker: a header button and its popover. The popover's contents and all
 * picker logic live in palette-picker-controller.ts, downloaded on first click.
 * Must sit inside .site-header (position: relative), which the popover is positioned against.
 */
---

<button
  class="icon-btn palette-btn"
  id="palette-btn"
  type="button"
  aria-label="Change colours"
  title="Change colours"
  aria-expanded="false"
  aria-controls="palette-pop"
>
  <span class="triad-icon" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </span>
</button>
<div class="palette-pop" id="palette-pop" role="dialog" aria-label="Colours" hidden></div>

<script>
  // Stub: the only picker code in the initial bundle. Loads the controller on first open.
  const button = document.getElementById('palette-btn');
  const pop = document.getElementById('palette-pop');
  if (button && pop) {
    const load = () => {
      button.removeEventListener('click', load);
      import('./palette-picker-controller').then(({ mountPalettePicker }) =>
        mountPalettePicker(button, pop),
      );
    };
    button.addEventListener('click', load);
  }
</script>

<style>
  /* Without JavaScript the picker can't work, so its button isn't shown. */
  :global(html:not(.js)) .palette-btn {
    display: none;
  }

  /* Three dots of the live triad. */
  .triad-icon {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
  }

  .triad-icon i {
    position: absolute;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
  }

  .triad-icon i:nth-child(1) {
    left: 0.265rem;
    top: 0;
    background: var(--accent);
  }

  .triad-icon i:nth-child(2) {
    left: 0;
    bottom: 0.02rem;
    background: var(--accent-2);
  }

  .triad-icon i:nth-child(3) {
    right: 0;
    bottom: 0.02rem;
    background: var(--muted);
  }

  /* The popover's contents are rendered by the controller, hence :global below. */
  .palette-pop {
    position: absolute;
    top: calc(100% - 0.5rem);
    right: 0;
    z-index: 20;
    display: grid;
    gap: 0.9rem;
    width: min(19rem, 100%);
    padding: 1rem;
    background: var(--surface);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 12px 32px var(--shadow);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .palette-pop[hidden] {
    display: none;
  }

  .palette-pop :global(.pop-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .palette-pop :global(.pop-head strong) {
    font-weight: 600;
  }

  .palette-pop :global(.pop-head span),
  .palette-pop :global(.pop-hint) {
    color: var(--muted);
  }

  .palette-pop :global(.pop-hint) {
    margin: 0;
    line-height: 1.5;
  }

  .palette-pop :global(.wheel) {
    position: relative;
    width: min(100%, 14rem);
    aspect-ratio: 1;
    margin-inline: auto;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }

  .palette-pop :global(.wheel canvas),
  .palette-pop :global(.wheel svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .palette-pop :global(.wheel canvas) {
    border-radius: 50%;
  }

  .palette-pop :global(.wheel svg) {
    overflow: visible;
    pointer-events: none;
  }

  .palette-pop :global(.wheel svg line),
  .palette-pop :global(.wheel svg polygon) {
    fill: none;
    stroke: var(--on-wheel);
    stroke-width: 0.6;
    stroke-opacity: 0.7;
  }

  .palette-pop :global(.wheel svg polygon) {
    stroke-dasharray: 1.6 1.2;
  }

  .palette-pop :global(.handle) {
    position: absolute;
    width: 1.35rem;
    height: 1.35rem;
    margin: -0.675rem 0 0 -0.675rem;
    padding: 0;
    background: var(--c); /* set by the controller before the popover shows */
    border: 2px solid var(--on-wheel);
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--shadow-edge),
      0 2px 6px var(--shadow);
    cursor: grab;
    touch-action: none;
  }

  .palette-pop :global(.handle.main) {
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.875rem 0 0 -0.875rem;
  }

  .palette-pop :global(.wheel.dragging),
  .palette-pop :global(.wheel.dragging .handle) {
    cursor: grabbing;
  }

  .palette-pop :global(.slider) {
    display: grid;
    gap: 0.35rem;
  }

  .palette-pop :global(.slider label) {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
  }

  .palette-pop :global(.slider input) {
    width: 100%;
    accent-color: var(--accent);
  }

  .palette-pop :global(.pop-foot) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .palette-pop :global(.pop-foot output) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .palette-pop :global(.btn) {
    padding: 0.35rem 0.7rem;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 4px;
    font: inherit;
    cursor: pointer;
  }

  .palette-pop :global(.btn:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .palette-pop :global(.btn:disabled) {
    color: var(--muted);
    border-color: var(--line);
    opacity: 0.5;
    cursor: default;
  }
</style>
