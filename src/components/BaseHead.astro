---
import { Font } from 'astro:assets';
import { SITE } from '../site';
import { DEFAULT_PALETTE, paletteCss, storedPaletteScript } from '../lib/palette';
import '../styles/global.css';

interface Props {
  /** Page title; omit on the home page to use the full site title. */
  title?: string;
  description?: string;
  /** Open Graph type: 'article' for Posts. */
  type?: 'website' | 'article';
}

const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultPaletteCss = paletteCss(DEFAULT_PALETTE);

// Runs before first paint, so there is no flash of the wrong Mode or of the Default Palette.
// Plain ES5 with no imports: it is inlined as-is.
const firstPaintScript = `document.documentElement.classList.add('js');
try {
  var mode = localStorage.getItem('mode');
  if (mode === 'dark' || mode === 'light') document.documentElement.setAttribute('data-theme', mode);
} catch (e) {}
${storedPaletteScript}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.shortTitle} />
<meta name="twitter:card" content="summary" />

<!-- Colour tokens, generated at build time from the Default Palette. -->
<style is:inline set:html={defaultPaletteCss} />

<!-- Preload only what the first screen needs; other weights and subsets load on demand. -->
<Font cssVariable="--font-mono" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
<Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />

<script is:inline set:html={firstPaintScript} />
