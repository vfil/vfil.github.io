---
import { Font } from 'astro:assets';
import { SITE } from '../site';
import { DEFAULT_PALETTE, PALETTE_STORAGE_KEY, paletteCss, RECIPE_VERSION } from '../lib/palette';
import '../styles/global.css';

interface Props {
  /** Page title; omit on the home page to use the full site title. */
  title?: string;
  description?: string;
  /** Open Graph type: 'article' for Posts. */
  type?: 'website' | 'article';
}

const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultPaletteCss = paletteCss(DEFAULT_PALETTE);

// Runs before first paint, so no flash of the wrong Mode or of the Default Palette. A stored Custom
// Palette carries its computed tokens, so this script never runs the colour maths. Plain ES5, no
// imports: it is inlined as-is.
const firstPaintScript = `(function () {
  var root = document.documentElement;
  root.classList.add('js');
  try {
    var mode = localStorage.getItem('mode');
    if (mode === 'dark' || mode === 'light') root.setAttribute('data-theme', mode);
    var raw = localStorage.getItem(${JSON.stringify(PALETTE_STORAGE_KEY)});
    if (!raw) return;
    var p = null;
    try { p = JSON.parse(raw); } catch (e) {}
    if (p && p.v === ${RECIPE_VERSION} && p.tokens && p.tokens.dark && p.tokens.light) {
      for (var t in p.tokens.dark) root.style.setProperty('--d-' + t, p.tokens.dark[t]);
      for (var u in p.tokens.light) root.style.setProperty('--l-' + u, p.tokens.light[u]);
      root.setAttribute('data-palette', 'custom');
    } else {
      localStorage.removeItem(${JSON.stringify(PALETTE_STORAGE_KEY)});
    }
  } catch (e) {}
})();`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.shortTitle} />
<meta name="twitter:card" content="summary" />

<!-- Colour tokens, generated at build time from the Default Palette. -->
<style is:inline set:html={defaultPaletteCss} />

<!-- Preload only what the first screen needs; other weights and subsets load on demand. -->
<Font cssVariable="--font-mono" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
<Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />

<script is:inline set:html={firstPaintScript} />
