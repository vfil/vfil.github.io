---
import BaseLayout from './BaseLayout.astro';
import CompanionFooter from '../components/CompanionFooter.astro';
import SeriesBox from '../components/SeriesBox.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TagList from '../components/TagList.astro';
import { formatDate, type PlaceInSeries, type Post } from '../lib/model';

interface Props {
  post: Post;
  place?: PlaceInSeries | undefined;
}

const { post, place } = Astro.props;
const repo = place?.series.repo;
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  current={post.category}
>
  <article class="post">
    <header class="post-head">
      <p class="meta">
        <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
        <span>·</span>
        <a class="cat" href={`/${post.category}/`}>
          [{post.category}]
        </a>
        <span>·</span>
        <span>{post.readingMinutes} min read</span>
        {post.updatedDate && (
          <>
            <span>·</span>
            <span>
              updated{' '}
              <time datetime={post.updatedDate.toISOString()}>{formatDate(post.updatedDate)}</time>
            </span>
          </>
        )}
        {post.draft && <span class="draft">[draft]</span>}
      </p>
      <h1 class="page-title">{post.title}</h1>
      {place && <SeriesBox place={place} />}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-foot">
      <TagList tags={post.tags} />
      {repo && <CompanionFooter repo={repo} snapshot={post.snapshot} />}
      {place && <SeriesNav place={place} />}
    </footer>
  </article>
</BaseLayout>

<script>
  // Copy button on every code block.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = 'copy';
    button.setAttribute('aria-label', 'Copy code to clipboard');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = 'copied';
        button.dataset.copied = '';
      } catch {
        button.textContent = 'press ⌘/Ctrl+C';
        getSelection()?.selectAllChildren(pre);
      }
      setTimeout(() => {
        button.textContent = 'copy';
        delete button.dataset.copied;
      }, 1500);
    });
    wrapper.append(button);
  }
</script>

<style>
  .post {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  /* Grid children default to min-width: auto, so a long code line would widen the page. */
  .post > *,
  .post-head > * {
    min-width: 0;
  }

  .post-head {
    display: grid;
    gap: 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .cat {
    color: var(--accent-2);
    text-decoration: none;
  }

  .cat:hover {
    color: var(--accent);
  }

  .draft {
    color: var(--accent);
  }

  .post-foot {
    display: grid;
    gap: 1.75rem;
  }
</style>
